# Скопируйте этот файл в .env.local на своём компьютере и заполните значения.
# На сервере те же имена передаются переменными окружения или секретами платформы.
# Пустая переменная не считается заданной: тогда читается локальный JSON в data/, если он есть.
# Не коммитьте .env, .env.local и файлы из data/ с живыми токенами и выгрузками.

# Единый OAuth Яндекс.Метрики на все счётчики холдинга.
YANDEX_METRIKA_OAUTH_TOKEN=

# OAuth Яндекс.Директа. Именная переменная важнее JSON ниже.
YANDEX_DIRECT_RTA_OAUTH_TOKEN=
YANDEX_DIRECT_TANDEM_OAUTH_TOKEN=
# Необязательный запасной вид: {"Tandem":"...","RTA":"..."}
YANDEX_DIRECT_TOKENS=

# Calltouch по siteId. Пример: {"47639":"...","57477":"..."}
# Если переменной нет, читается data/calltouch-tokens.json.
CALLTOUCH_TOKENS=

# Telegram. Если переменная задана, она важнее полей в разделе «Подключение».
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# warning (по умолчанию) или critical
TELEGRAM_MIN_SEVERITY=warning
# 1 — не отправлять, только собрать текст
TELEGRAM_DRY_RUN=

# Google Таблица. Чтение только в дашборд, запись в таблицу не делается.
# Id ниже — публичный лист классифайдов «Текущий месяц», это не секрет.
# Реальные строки из таблицы в git не попадают: они пишутся в data/classifieds.json.
GOOGLE_SHEETS_ID=1mieIw-b8wnJVvRJrbr9onoLMItHWHwESYEf5QIqqC8I
# gid листа классифайдов. 0 — «Текущий месяц».
GOOGLE_SHEETS_CLASSIFIEDS_GID=0
# Имя листа нужно только для сервисного аккаунта, если gid не используете.
GOOGLE_SHEETS_CLASSIFIEDS_TAB=
# План медиа (Директ) в этой таблице не лежит. Задайте лист, когда он появится.
GOOGLE_SHEETS_PLANS_TAB=
GOOGLE_SHEETS_PLANS_GID=
# Как часто тянуть таблицу, в часах. По умолчанию 3.
GOOGLE_SHEETS_SYNC_HOURS=3
# Необязательно: ключ API для публичной таблицы через Sheets API.
GOOGLE_SHEETS_API_KEY=
# Необязательно: сервисный аккаунт, только чтение. JSON одной строкой
# или пара email + ключ (переносы в ключе как \n).
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
